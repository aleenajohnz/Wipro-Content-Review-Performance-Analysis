# ============================================================
# WIPRO CONTENT REVIEW PERFORMANCE ANALYSIS
# Complete Python Program
# ============================================================

import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# ============================================================
# 1. LOAD DATASET
# ============================================================

df = pd.read_csv("YouTube_Content_Review_Data.csv")

print("First 5 rows:")
display(df.head())

print("\nDataset shape:")
print(df.shape)

print("\nColumn names:")
print(df.columns.tolist())

# ============================================================
# 2. CHECK DATA TYPES AND MISSING VALUES
# ============================================================

print("\nDataset information:")
df.info()

print("\nMissing values:")
print(df.isnull().sum())

# ============================================================
# 3. REMOVE UNNECESSARY COLUMN
# ============================================================

df = df.drop(columns=["Unnamed: 20"])

print("\nDataset shape after removing unwanted column:")
print(df.shape)

# ============================================================
# 4. CONVERT PERCENTAGE COLUMNS TO NUMERIC
# ============================================================

percentage_columns = [
    "Productivity_Percent",
    "Quality_Percent",
    "Accuracy_Percent",
    "Adherence_Percent",
    "Overall_Score"
]

for col in percentage_columns:
    df[col] = df[col].str.replace("%", "").astype(float)

# ============================================================
# 5. CONVERT DATE COLUMN
# ============================================================

df["Week_Start_Date"] = pd.to_datetime(
    df["Week_Start_Date"],
    format="%d-%m-%Y"
)

print("\nData types after cleaning:")
print(df.dtypes)

# ============================================================
# 6. OVERALL KPIs
# ============================================================

print("\n================ OVERALL KPIs ================")

print(
    "Average Productivity:",
    round(df["Productivity_Percent"].mean(), 2),
    "%"
)

print(
    "Average Quality:",
    round(df["Quality_Percent"].mean(), 2),
    "%"
)

print(
    "Average Accuracy:",
    round(df["Accuracy_Percent"].mean(), 2),
    "%"
)

print(
    "Average Adherence:",
    round(df["Adherence_Percent"].mean(), 2),
    "%"
)

print(
    "Average Overall Score:",
    round(df["Overall_Score"].mean(), 2),
    "%"
)

print(
    "Total Cases Reviewed:",
    df["Cases_Reviewed"].sum()
)

print(
    "Total Target Cases:",
    df["Target_Cases"].sum()
)

print(
    "Total Errors:",
    df["Errors"].sum()
)

print(
    "Total Overtime Hours:",
    df["Overtime_Hours"].sum()
)

# ============================================================
# 7. PERFORMANCE STATUS
# ============================================================

status_counts = df["Performance_Status"].value_counts()

print("\n================ PERFORMANCE STATUS ================")
print(status_counts)

status_percentage = (
    df["Performance_Status"]
    .value_counts(normalize=True)
    .mul(100)
    .round(2)
)

print("\nPerformance Status Percentage:")
print(status_percentage)

# ============================================================
# 8. TEAM PERFORMANCE ANALYSIS
# ============================================================

team_performance = df.groupby("Team").agg(
    Average_Productivity=("Productivity_Percent", "mean"),
    Average_Quality=("Quality_Percent", "mean"),
    Average_Accuracy=("Accuracy_Percent", "mean"),
    Average_Adherence=("Adherence_Percent", "mean"),
    Average_Overall_Score=("Overall_Score", "mean"),
    Total_Cases=("Cases_Reviewed", "sum"),
    Total_Errors=("Errors", "sum"),
    Total_Overtime=("Overtime_Hours", "sum")
).round(2)

print("\n================ TEAM PERFORMANCE ================")
display(team_performance)

# ============================================================
# 9. TEAM ERROR RATE
# ============================================================

team_analysis = df.groupby("Team").agg(
    Average_Productivity=("Productivity_Percent", "mean"),
    Average_Quality=("Quality_Percent", "mean"),
    Average_Accuracy=("Accuracy_Percent", "mean"),
    Total_Cases=("Cases_Reviewed", "sum"),
    Total_Errors=("Errors", "sum")
).round(2)

team_analysis["Error_Rate_Percent"] = (
    team_analysis["Total_Errors"] /
    team_analysis["Total_Cases"] * 100
).round(2)

print("\n================ TEAM ERROR RATE ================")
display(team_analysis)

# ============================================================
# 10. WEEKLY PERFORMANCE ANALYSIS
# ============================================================

weekly_performance = df.groupby("Week_Number").agg(
    Average_Productivity=("Productivity_Percent", "mean"),
    Average_Quality=("Quality_Percent", "mean"),
    Average_Accuracy=("Accuracy_Percent", "mean"),
    Average_Adherence=("Adherence_Percent", "mean"),
    Average_Overall_Score=("Overall_Score", "mean"),
    Total_Cases=("Cases_Reviewed", "sum"),
    Total_Errors=("Errors", "sum")
).round(2)

print("\n================ WEEKLY PERFORMANCE ================")
display(weekly_performance)

# ============================================================
# 11. EMPLOYEE-LEVEL PERFORMANCE
# ============================================================

employee_performance = df.groupby(
    ["Employee_ID", "Employee_Name"]
).agg(
    Average_Productivity=("Productivity_Percent", "mean"),
    Average_Quality=("Quality_Percent", "mean"),
    Average_Accuracy=("Accuracy_Percent", "mean"),
    Average_Adherence=("Adherence_Percent", "mean"),
    Average_Overall_Score=("Overall_Score", "mean"),
    Total_Cases=("Cases_Reviewed", "sum"),
    Total_Errors=("Errors", "sum"),
    Total_Overtime=("Overtime_Hours", "sum")
).round(2)

print("\n================ EMPLOYEE PERFORMANCE ================")
display(employee_performance.head(10))

# ============================================================
# 12. TOP EMPLOYEES BY OVERALL SCORE
# ============================================================

top_employees = employee_performance.sort_values(
    "Average_Overall_Score",
    ascending=False
).head(10)

print("\n================ TOP 10 EMPLOYEES BY OVERALL SCORE ================")
display(top_employees)

# ============================================================
# 13. BOTTOM EMPLOYEES BY OVERALL SCORE
# ============================================================

bottom_employees = employee_performance.sort_values(
    "Average_Overall_Score",
    ascending=True
).head(10)

print("\n================ BOTTOM 10 EMPLOYEES BY OVERALL SCORE ================")
display(bottom_employees)

# ============================================================
# 14. EMPLOYEE ERROR RATE
# ============================================================

employee_analysis = employee_performance.copy()

employee_analysis["Error_Rate_Percent"] = (
    employee_analysis["Total_Errors"] /
    employee_analysis["Total_Cases"] * 100
).round(2)

print("\n================ EMPLOYEE ERROR RATE ================")
display(employee_analysis.head(10))

# ============================================================
# 15. HIGHEST ERROR RATE EMPLOYEES
# ============================================================

highest_error_employees = employee_analysis.sort_values(
    "Error_Rate_Percent",
    ascending=False
).head(10)

print("\n================ HIGHEST ERROR RATE EMPLOYEES ================")
display(highest_error_employees)

# ============================================================
# 16. LOWEST ERROR RATE EMPLOYEES
# ============================================================

lowest_error_employees = employee_analysis.sort_values(
    "Error_Rate_Percent",
    ascending=True
).head(10)

print("\n================ LOWEST ERROR RATE EMPLOYEES ================")
display(lowest_error_employees)

# ============================================================
# 17. TEAM PERFORMANCE STATUS
# ============================================================

team_status = pd.crosstab(
    df["Team"],
    df["Performance_Status"],
    normalize="index"
).mul(100).round(2)

print("\n================ TEAM PERFORMANCE STATUS ================")
display(team_status)

# ============================================================
# 18. PERFORMANCE STATUS ERROR ANALYSIS
# ============================================================

status_error_analysis = df.groupby(
    "Performance_Status"
).agg(
    Total_Cases=("Cases_Reviewed", "sum"),
    Total_Errors=("Errors", "sum"),
    Average_Quality=("Quality_Percent", "mean"),
    Average_Productivity=("Productivity_Percent", "mean"),
    Average_Overall_Score=("Overall_Score", "mean")
).round(2)

status_error_analysis["Error_Rate_Percent"] = (
    status_error_analysis["Total_Errors"] /
    status_error_analysis["Total_Cases"] * 100
).round(2)

print("\n================ PERFORMANCE STATUS ERROR ANALYSIS ================")
display(status_error_analysis)

# ============================================================
# 19. ATTENDANCE ANALYSIS
# ============================================================

attendance_analysis = df.groupby("Employee_ID").agg(
    Total_Present_Days=("Present_Days", "sum"),
    Total_Absent_Days=("Absent_Days", "sum"),
    Total_Leave_Days=("Leave_Days", "sum"),
    Average_Productivity=("Productivity_Percent", "mean"),
    Average_Overall_Score=("Overall_Score", "mean"),
    Total_Cases=("Cases_Reviewed", "sum"),
    Total_Errors=("Errors", "sum")
).round(2)

attendance_analysis["Error_Rate_Percent"] = (
    attendance_analysis["Total_Errors"] /
    attendance_analysis["Total_Cases"] * 100
).round(2)

print("\n================ ATTENDANCE ANALYSIS ================")
display(attendance_analysis.head(10))

# ============================================================
# 20. CORRELATION ANALYSIS
# ============================================================

productivity_quality_corr = df[
    ["Productivity_Percent", "Quality_Percent"]
].corr()

print("\n================ PRODUCTIVITY VS QUALITY CORRELATION ================")
display(productivity_quality_corr)

correlation_matrix = df[
    [
        "Productivity_Percent",
        "Quality_Percent",
        "Accuracy_Percent",
        "Adherence_Percent",
        "Overall_Score"
    ]
].corr().round(2)

print("\n================ CORRELATION MATRIX ================")
display(correlation_matrix)

# ============================================================
# 21. OVERTIME CORRELATION
# ============================================================

overtime_performance_corr = employee_analysis[
    [
        "Total_Overtime",
        "Average_Productivity",
        "Average_Quality",
        "Average_Overall_Score",
        "Error_Rate_Percent"
    ]
].corr().round(2)

print("\n================ OVERTIME CORRELATION ================")
display(overtime_performance_corr)

# ============================================================
# 22. ATTENDANCE CORRELATION
# ============================================================

attendance_correlation = attendance_analysis[
    [
        "Total_Present_Days",
        "Total_Absent_Days",
        "Total_Leave_Days",
        "Average_Productivity",
        "Average_Overall_Score",
        "Error_Rate_Percent"
    ]
].corr().round(2)

print("\n================ ATTENDANCE CORRELATION ================")
display(attendance_correlation)

# ============================================================
# 23. CASES VS PERFORMANCE CORRELATION
# ============================================================

cases_performance_corr = employee_analysis[
    [
        "Total_Cases",
        "Average_Productivity",
        "Average_Quality",
        "Average_Overall_Score",
        "Error_Rate_Percent"
    ]
].corr().round(2)

print("\n================ CASES VS PERFORMANCE CORRELATION ================")
display(cases_performance_corr)

# ============================================================
# 24. FINAL SUMMARY
# ============================================================

overall_error_rate = (
    df["Errors"].sum() /
    df["Cases_Reviewed"].sum() * 100
)

met_or_exceeded = (
    df["Performance_Status"]
    .isin(["Met Target", "Exceeded Target"])
    .mean() * 100
)

final_summary = pd.DataFrame({
    "Metric": [
        "Average Productivity",
        "Average Quality",
        "Average Accuracy",
        "Average Adherence",
        "Average Overall Score",
        "Total Cases Reviewed",
        "Total Errors",
        "Total Overtime Hours",
        "Overall Error Rate",
        "Met or Exceeded Target (%)"
    ],
    "Value": [
        round(df["Productivity_Percent"].mean(), 2),
        round(df["Quality_Percent"].mean(), 2),
        round(df["Accuracy_Percent"].mean(), 2),
        round(df["Adherence_Percent"].mean(), 2),
        round(df["Overall_Score"].mean(), 2),
        df["Cases_Reviewed"].sum(),
        df["Errors"].sum(),
        df["Overtime_Hours"].sum(),
        round(overall_error_rate, 2),
        round(met_or_exceeded, 2)
    ]
})

print("\n================ FINAL SUMMARY ================")
display(final_summary)

