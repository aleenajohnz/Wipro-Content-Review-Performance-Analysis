# 36. COMPLETE DASHBOARD
# FIXED LAYOUT - NO OVERLAPPING CHARTS
# ============================================================

fig = plt.figure(
    figsize=(16, 12),
    constrained_layout=True
)

# ============================================================
# DASHBOARD TITLE
# ============================================================

fig.suptitle(
    "Content Review Performance Dashboard",
    fontsize=22,
    fontweight="bold"
)

# ============================================================
# CREATE DASHBOARD GRID
# ============================================================

gs = fig.add_gridspec(
    4,
    6,
    height_ratios=[0.8, 1.5, 2.5, 2.5]
)

# ============================================================
# KPI CARDS
# ============================================================

kpis = [
    ("Productivity", df["Productivity_Percent"].mean()),
    ("Quality", df["Quality_Percent"].mean()),
    ("Accuracy", df["Accuracy_Percent"].mean()),
    ("Adherence", df["Adherence_Percent"].mean()),
    ("Overall Score", df["Overall_Score"].mean()),
    ("Error Rate", overall_error_rate)
]

for i, (name, value) in enumerate(kpis):

    ax = fig.add_subplot(
        gs[0, i]
    )

    ax.text(
        0.5,
        0.62,
        f"{value:.2f}%",
        ha="center",
        va="center",
        fontsize=18,
        fontweight="bold"
    )

    ax.text(
        0.5,
        0.20,
        name,
        ha="center",
        va="center",
        fontsize=10
    )

    ax.set_xticks([])
    ax.set_yticks([])

    # Border around KPI card
    for spine in ax.spines.values():
        spine.set_visible(True)

